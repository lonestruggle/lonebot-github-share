{
  "version": "0.3.300",
  "source": "https://stormjavadocs.z6.web.core.windows.net/index.html",
  "notes": "LoneBot Storm-compat script API. status: done | partial | later. Geen sailing / POH collision-binary dump.",
  "mouseFlow": [
    "1. ClickPoints.forNpc/Object/Widget → random point in hull/clickbox/bounds",
    "2. MouseMovementStrategy.generatePath(current, target) → Bezier/Linear/Direct shape",
    "3. MouseManager.resamplePath(points, target) → density by distance",
    "4. MouseManager.moveAlongPath(..., ease, fatigue) → Mouse.moveRaw each step",
    "5. short human delay",
    "6. Mouse.clickOnly(x,y) via active MouseBackend",
    "INVOKE: Client.menuAction / MenuInteract where Storm uses queue"
  ],
